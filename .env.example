# ═══════════════════════════════════════════════════
#  RAG Knowledge Assistant — Environment Configuration
# ═══════════════════════════════════════════════════

# ── Ports ─────────────────────────────────────────
API_PORT=8000
FRONTEND_PORT=3000
QDRANT_PORT=6333
REDIS_PORT=6379
OLLAMA_PORT=11434

# ── LLM Configuration ────────────────────────────
# Provider: "ollama" (local) or "openai" (cloud)
LLM_PROVIDER=ollama

# Ollama settings
OLLAMA_MODEL=llama3.2

# OpenAI settings (only if LLM_PROVIDER=openai)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ── Embedding Model ──────────────────────────────
EMBEDDING_MODEL=all-MiniLM-L6-v2

# ── Logging ───────────────────────────────────────
LOG_LEVEL=INFO
